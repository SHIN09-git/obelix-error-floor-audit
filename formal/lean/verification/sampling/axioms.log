@Mard.grouped_median_optimal : ∀ {I : Type u_1} {G : Type u_2} (s : Finset I),
  s.Nonempty →
    ∀ (y : I → ℝ) (group : I → G),
      Mard.optimalRisk s y group =
        (∑ g ∈ Finset.image group s,
            Mard.absLoss (Mard.groupLabels s y group g) (Mard.sampleMedian (Mard.groupLabels s y group g))) /
          ↑s.card
@Mard.feature_refinement : ∀ {I : Type u_1} {X : Type u_2} {G : Type u_3} (s : Finset I) (y : I → ℝ) (rich : I → X)
  (coarse : I → G) (forget : X → G),
  (∀ i ∈ s, coarse i = forget (rich i)) → Mard.optimalRisk s y rich ≤ Mard.optimalRisk s y coarse
@Mard.population_feature_refinement : ∀ {X : Type u_1} {G : Type u_2} {Ω : Type u_3} [inst : MeasurableSpace Ω]
  [inst_1 : MeasurableSpace X] [inst_2 : MeasurableSpace G] (μ : MeasureTheory.Measure Ω) (y : Ω → ℝ) (rich : Ω → X)
  (forget : X → G), Measurable forget → Mard.populationRisk μ y rich ≤ Mard.populationRisk μ y (forget ∘ rich)
Mard.Counterexample.population_counterexample :
  Mard.populationRisk Mard.Counterexample.coinMeasure Mard.Counterexample.outcome Mard.Counterexample.coarse =
      ENNReal.ofReal (41 / 100) ∧
    Mard.populationRisk Mard.Counterexample.coinMeasure Mard.Counterexample.outcome Mard.Counterexample.feature = 0 ∧
      Measurable Mard.Counterexample.predictor ∧
        (∀ (u : Bool), Mard.Counterexample.predictor (Mard.Counterexample.feature u) = Mard.Counterexample.outcome u) ∧
          (Mard.Counterexample.feature true - Mard.Counterexample.feature false) / Mard.Counterexample.feature false =
            3 / 250
@Mard.Sampling.expected_empirical_inf_le : ∀ {n : ℕ} {Ω : Type u_1} [inst : MeasurableSpace Ω]
  {P : MeasureTheory.Measure Ω} [MeasureTheory.IsProbabilityMeasure P] {ν : MeasureTheory.Measure ℝ}
  {Y : Fin n → Ω → ℝ},
  0 < n →
    (∀ (i : Fin n), ProbabilityTheory.HasLaw (Y i) ν P) →
      MeasureTheory.Integrable id ν →
        ∫ (ω : Ω), sInf (Set.range (Mard.Sampling.sampleRisk fun i => Y i ω)) ∂P ≤
          sInf (Set.range fun c => ∫ (y : ℝ), |y - c| ∂ν)
@Mard.Sampling.iid_product_bias : ∀ {n : ℕ},
  0 < n →
    ∀ (ν : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure ν],
      MeasureTheory.Integrable id ν →
        (∫ (y : Fin n → ℝ), Mard.Sampling.fittedRisk y ∂MeasureTheory.Measure.pi fun x => ν) ≤
          Mard.Sampling.optimalPopulationRisk ν
@Mard.Sampling.gaussian_two_bias : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {P : MeasureTheory.Measure Ω}
  {Y : Fin 2 → Ω → ℝ} {m : ℝ} (τ : NNReal),
  (∀ (i : Fin 2), ProbabilityTheory.HasLaw (Y i) (ProbabilityTheory.gaussianReal m (τ ^ 2)) P) →
    ProbabilityTheory.IndepFun (Y 0) (Y 1) P →
      have empirical := ∫ (ω : Ω), Mard.Sampling.fittedRisk fun i => Y i ω ∂P;
      have population := Mard.Sampling.optimalPopulationRisk (ProbabilityTheory.gaussianReal m (τ ^ 2));
      empirical = ↑τ / √Real.pi ∧ population = ↑τ * √(2 / Real.pi) ∧ population = √2 * empirical
@Mard.Sampling.gaussian_two_above_threshold : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {P : MeasureTheory.Measure Ω}
  {Y : Fin 2 → Ω → ℝ} {m : ℝ} {τ : NNReal},
  0 < τ →
    (∀ (i : Fin 2), ProbabilityTheory.HasLaw (Y i) (ProbabilityTheory.gaussianReal m (τ ^ 2)) P) →
      ProbabilityTheory.IndepFun (Y 0) (Y 1) P → ∀ (r : ℝ), 0 < P {ω | r < Mard.Sampling.fittedRisk fun i => Y i ω}
